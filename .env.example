# ==========================================
# VoiceCraft Configuration & Environment File
# ==========================================

# Server Host & Port
SERVER_HOST=127.0.0.1
SERVER_PORT=7860

# Model Selection (v3 recommended for multilingual synthesis)
CHATTERBOX_MULTILINGUAL_T3_MODEL=v3

# Default Language (e.g. en, hi, fr, de, es, ja, etc.)
DEFAULT_LANGUAGE=en

# Telegram Bot Token (Keep Private!)
# Obtain via @BotFather on Telegram: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Bot Default Target Language for Cloned Voice
TELEGRAM_DEFAULT_LANG=en
